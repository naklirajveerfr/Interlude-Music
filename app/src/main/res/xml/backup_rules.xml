<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Settings and logins (YouTube cookie, Spotify token) stay out of cloud backups -->
    <exclude
        domain="file"
        path="datastore" />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
</full-backup-content>